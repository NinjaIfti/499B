\contentsline {chapter}{\numberline {8}Conclusion}{63}{chapter.8}%
\contentsline {section}{\numberline {8.1}Summary}{63}{section.8.1}%
\contentsline {section}{\numberline {8.2}Findings}{64}{section.8.2}%
\contentsline {paragraph}{The agentic pipeline beats single-shot prompting on every metric that discriminates.}{64}{section*.59}%
\contentsline {paragraph}{The most instructive finding is that the obvious metrics do not work.}{64}{section*.60}%
\contentsline {paragraph}{Winning as a whole is not the same as knowing why.}{64}{section*.61}%
\contentsline {section}{\numberline {8.3}Limitations}{64}{section.8.3}%
\contentsline {paragraph}{The pipeline labelling rests on generation records, not on the artifacts.}{64}{section*.62}%
\contentsline {paragraph}{The judge and the Answer Generator are language models, not humans.}{65}{section*.63}%
\contentsline {paragraph}{Generator--solver agreement is not the same as correctness.}{65}{section*.64}%
\contentsline {paragraph}{The result is a comparison of two pipelines, not an attribution.}{65}{section*.65}%
\contentsline {paragraph}{Single domain, single document.}{65}{section*.66}%
\contentsline {paragraph}{The extraction layer bounds everything above it.}{65}{section*.67}%
\contentsline {paragraph}{Deployment is not production-grade.}{66}{section*.68}%
\contentsline {section}{\numberline {8.4}Future Improvement}{66}{section.8.4}%
\contentsline {paragraph}{Confirm the arm labelling before anything else.}{66}{section*.69}%
\contentsline {paragraph}{Run the ablations, and read them against cost.}{66}{section*.70}%
\contentsline {paragraph}{Evaluate under a published benchmark.}{66}{section*.71}%
\contentsline {paragraph}{Strengthen answer verification.}{66}{section*.72}%
\contentsline {paragraph}{Human evaluation.}{67}{section*.73}%
\contentsline {paragraph}{Broaden the domain.}{67}{section*.74}%
\contentsline {paragraph}{Close the loop on diversity.}{67}{section*.75}%
