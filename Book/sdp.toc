\contentsline {section}{\numberline {8.1}Summary}{30}{section.8.1}%
\contentsline {section}{\numberline {8.2}Limitations}{31}{section.8.2}%
\contentsline {paragraph}{The judge and the Answer Generator are LLMs, not humans.}{31}{section*.35}%
\contentsline {paragraph}{The Answer Generator is weak, which bounds every answer-correctness number.}{31}{section*.36}%
\contentsline {paragraph}{The CoT and PoT comparison is not yet complete.}{31}{section*.37}%
\contentsline {paragraph}{Single domain, single document.}{31}{section*.38}%
\contentsline {paragraph}{The extraction layer bounds everything above it.}{31}{section*.39}%
\contentsline {paragraph}{The agentic pipeline's diversity failure at hard difficulty is unresolved.}{31}{section*.40}%
\contentsline {paragraph}{Deployment is not production-grade.}{32}{section*.41}%
\contentsline {section}{\numberline {8.3}Future Improvement}{32}{section.8.3}%
\contentsline {paragraph}{Fix the diversity collapse first.}{32}{section*.42}%
\contentsline {paragraph}{Strengthen answer verification.}{32}{section*.43}%
\contentsline {paragraph}{Human evaluation.}{32}{section*.44}%
\contentsline {paragraph}{Broaden the domain.}{32}{section*.45}%
