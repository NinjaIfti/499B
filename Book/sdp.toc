\contentsline {section}{\numberline {4.3}Results and Discussion}{19}{section.4.3}%
\contentsline {subsection}{\numberline {4.3.1}Findings}{20}{subsection.4.3.1}%
\contentsline {paragraph}{1. The agentic pipeline produces more answer-correct questions, and the gap widens with difficulty.}{20}{section*.21}%
\contentsline {paragraph}{2. Diversity, not quality, is the discriminator --- and it reverses at hard.}{20}{section*.22}%
\contentsline {paragraph}{3. The Answer Generator is a weak instrument, and this bounds the answer metrics.}{20}{section*.23}%
\contentsline {paragraph}{4. Self-validation works, but imperfectly.}{21}{section*.24}%
\contentsline {paragraph}{5. The agentic pipeline is roughly seven times more expensive.}{21}{section*.25}%
\contentsline {section}{\numberline {4.4}Summary}{21}{section.4.4}%
