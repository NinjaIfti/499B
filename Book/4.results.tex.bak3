\begin{table}[H]
\centering
\caption{Native metrics broken down by target difficulty, $n$ per cell as shown.
Higher is better except duplicate rate.}
\label{tab:native-difficulty}
\footnotesize
\setlength{\tabcolsep}{4pt}
\begin{tabular}{|l|l|c|c|c|c|c|c|}
\hline
\textbf{Difficulty} & \textbf{Pipeline} & \textbf{$n$} & \textbf{Duplicate}
 & \textbf{Grounding} & \textbf{Eff.\ accept} & \textbf{Indep.\ match}
 & \textbf{Verified} \\
\hline
Easy   & Non-agentic & 68 & 0.353 & 0.562 & 0.647 & 0.971 & 1.000 \\
       & Agentic     & 68 & \textbf{0.324} & \textbf{0.642} & \textbf{0.676} & 0.971 & 0.985 \\
\hline
Medium & Non-agentic & 66 & 0.379 & 0.595 & 0.612 & 0.879 & 0.985 \\
