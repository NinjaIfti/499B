\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.1}Findings}{20}{subsection.4.3.1}\protected@file@percent }
\newlabel{sec:res-findings}{{4.3.1}{20}{Findings}{subsection.4.3.1}{}}
\@writefile{toc}{\contentsline {paragraph}{1. The agentic pipeline produces more answer-correct questions, and the gap widens with difficulty.}{20}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. Diversity, not quality, is the discriminator --- and it reverses at hard.}{20}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. The Answer Generator is a weak instrument, and this bounds the answer metrics.}{20}{section*.23}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. Self-validation works, but imperfectly.}{21}{section*.24}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{5. The agentic pipeline is roughly seven times more expensive.}{21}{section*.25}\protected@file@percent }
