\contentsline {table}{\numberline {4.5}{\ignorespaces Native metrics, $n{=}200$ questions per pipeline. Judged dimensions are on a $1$--$5$ scale; the remaining measures are rates or cosine scores in $[0,1]$. Higher is better for every row \emph {except} duplicate rate and inter-question similarity.}}{33}{table.4.5}%
\contentsline {table}{\numberline {4.6}{\ignorespaces Native metrics broken down by target difficulty, $n$ per cell as shown. Higher is better except duplicate rate.}}{33}{table.4.6}%
