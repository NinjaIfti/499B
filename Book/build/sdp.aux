\@writefile{toc}{\contentsline {subsection}{\numberline {3.3.1}The agentic question-generation loop}{22}{subsection.3.3.1}\protected@file@percent }
\newlabel{sec:meth-agentic}{{3.3.1}{22}{The agentic question-generation loop}{subsection.3.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces The agentic question-generation loop. Questions are produced one at a time and must pass validation before the next slot begins. The dashed edge is genuine tool use: the generator decides for itself whether it has enough grounding and issues its own retrieval query if not. On \texttt  {FAIL} the validator does not merely reject --- it selects the remediation, and only \texttt  {regenerate} returns to the generator directly, while \texttt  {fetch\_context} and \texttt  {replan\_topic} require work outside the model first. When the retry budget is exhausted the best attempt is kept but is explicitly labelled an override, so that a failure is never recorded as a clean pass.}}{24}{figure.3.2}\protected@file@percent }
\newlabel{fig:agentic-loop}{{3.2}{24}{The agentic question-generation loop. Questions are produced one at a time and must pass validation before the next slot begins. The dashed edge is genuine tool use: the generator decides for itself whether it has enough grounding and issues its own retrieval query if not. On \texttt {FAIL} the validator does not merely reject --- it selects the remediation, and only \texttt {regenerate} returns to the generator directly, while \texttt {fetch\_context} and \texttt {replan\_topic} require work outside the model first. When the retry budget is exhausted the best attempt is kept but is explicitly labelled an override, so that a failure is never recorded as a clean pass}{figure.3.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3.2}The four generation pipelines}{24}{subsection.3.3.2}\protected@file@percent }
\newlabel{sec:meth-pipelines}{{3.3.2}{24}{The four generation pipelines}{subsection.3.3.2}{}}
