\@writefile{toc}{\contentsline {section}{\numberline {8.2}Findings}{56}{section.8.2}\protected@file@percent }
\newlabel{sec:concl-findings}{{8.2}{56}{Findings}{section.8.2}{}}
\@writefile{toc}{\contentsline {paragraph}{The agentic pipeline beats single-shot prompting on every metric that discriminates.}{56}{section*.45}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The most instructive finding is that the obvious metrics do not work.}{56}{section*.46}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Winning as a whole is not the same as knowing why.}{56}{section*.47}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8.3}Limitations}{56}{section.8.3}\protected@file@percent }
\newlabel{sec:concl-limits}{{8.3}{56}{Limitations}{section.8.3}{}}
\@writefile{toc}{\contentsline {paragraph}{The pipeline labelling rests on generation records, not on the artifacts.}{56}{section*.48}\protected@file@percent }
\citation{zheng2023judging}
\citation{sympy}
\citation{openstax_calculus}
\citation{chen2023pot}
\@writefile{toc}{\contentsline {paragraph}{The judge and the Answer Generator are language models, not humans.}{57}{section*.49}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Generator--solver agreement is not the same as correctness.}{57}{section*.50}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The result is a comparison of two pipelines, not an attribution.}{57}{section*.51}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Single domain, single document.}{57}{section*.52}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The extraction layer bounds everything above it.}{57}{section*.53}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Deployment is not production-grade.}{58}{section*.54}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8.4}Future Improvement}{58}{section.8.4}\protected@file@percent }
\newlabel{sec:concl-future}{{8.4}{58}{Future Improvement}{section.8.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Confirm the arm labelling before anything else.}{58}{section*.55}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Run the ablations, and read them against cost.}{58}{section*.56}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Evaluate under a published benchmark.}{58}{section*.57}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Strengthen answer verification.}{58}{section*.58}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Human evaluation.}{59}{section*.59}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Broaden the domain.}{59}{section*.60}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Close the loop on diversity.}{59}{section*.61}\protected@file@percent }
